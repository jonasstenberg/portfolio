{
  "name": "cv-api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun build --compile --minify --target=bun-linux-x64 src/index.ts --outfile dist/cv-api",
    "typecheck": "bunx tsc --noEmit"
  },
  "dependencies": {
    "graphql": "^16",
    "graphql-yoga": "^5.21.2"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2"
  }
}
