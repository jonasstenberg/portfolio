[Unit]
Description=CV GraphQL API (stenberg.io/graphql)
After=network.target

[Service]
WorkingDirectory=/usr/local/bin/cv-api/
ExecStart=/usr/local/bin/cv-api/cv-api
User=jonas
Group=jonas
Environment=HOST=127.0.0.1
Environment=PORT=4000
Restart=always
RestartSec=2

ProtectSystem=full
ProtectHome=true
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true

[Install]
WantedBy=multi-user.target
