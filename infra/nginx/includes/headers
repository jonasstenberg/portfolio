add_header Strict-Transport-Security "max-age=15768000; preload" always;
add_header X-XSS-Protection "1; mode=block";
add_header X-Content-Type-Options nosniff;
add_header X-Frame-Options "SAMEORIGIN";
# connect-src 'self', worker-src and data: URIs are needed by the GraphiQL page
# at /graphiql/ (fetches /graphql, runs Monaco editor workers, inlines small assets).
add_header Content-Security-Policy "default-src 'self'; script-src 'self' *.stenberg.io; script-src-elem 'self' 'unsafe-inline' https://analytics.stenberg.io; connect-src 'self' https://analytics.stenberg.io; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; worker-src 'self';";
add_header 'Referrer-Policy' 'strict-origin';
add_header Permissions-Policy "fullscreen=(self)";

location ~* \.(gif|jpeg|jpg|webp|png|svg|js|css)$ {
  add_header Cache-Control "max-age=31536000";
}
